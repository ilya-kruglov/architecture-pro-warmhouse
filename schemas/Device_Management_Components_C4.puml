@startuml Device_Management_Components

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

title Device Management Service\nДиаграмма компонентов

Container_Boundary(device_service, "Device Management Service") {
    
    Component(device_api, "Device API", "REST/gRPC", "Внешний API для операций\nс устройствами. Валидация запросов.")
    
    Component(device_manager, "Device Manager", "Бизнес-логика", "Основная логика управления\nустройствами: регистрация, обновление, удаление.")
    
    Component(state_manager, "State Manager", "Бизнес-логика", "Управление состоянием устройств\n(онлайн/оффлайн, статус, настройки).")
    
    Component(device_repository, "Device Repository", "Data Access", "Абстракция доступа к БД.\nORM/паттерн Repository.")
    
    Component(event_publisher, "Event Publisher", "Интеграция", "Публикация событий об изменениях\nустройств в Message Broker.")
    
    Component(auth_client, "Auth Client", "Интеграция", "Клиент для проверки прав доступа\nк устройствам через User Service.")
}

' --- Взаимодействия ---
Rel(device_api, device_manager, "Вызывает", "Методы сервиса")
Rel(device_manager, state_manager, "Обновляет состояние", "Методы")
Rel(device_manager, device_repository, "Сохраняет/загружает", "Методы репозитория")
Rel(device_manager, event_publisher, "Публикует события", "Kafka Client")
Rel(device_api, auth_client, "Проверяет доступ", "gRPC вызов")
Rel(auth_client, user_service, "User Service", "gRPC")
Rel(device_repository, device_db, "Device Database", "SQL")
Rel(event_publisher, message_broker, "Kafka", "Kafka Protocol")

@enduml